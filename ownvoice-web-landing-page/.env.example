# Database (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Cryptographic secrets — REQUIRED in production (min 32 chars each).
# Generate strong values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty for local development: the app then uses clearly-marked throwaway
# dev secrets and refuses to start in production without these variables.
JWT_SECRET=""
ENCRYPTION_SECRET=""

# Payment Gateways
# 1. Global / International (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# 2. Indian Consumers (Cashfree Payments)
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENVIRONMENT="sandbox" # sandbox or production

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Local development only: allows the checkout endpoints to mint a licence
# without a payment gateway. Ignored entirely when NODE_ENV=production.
OWNVOICE_ENABLE_TEST_CHECKOUT="false"

# Database seed (npm run db:seed). The admin password is generated when unset
# and printed once; set it here to choose your own (min 12 chars).
SEED_ADMIN_EMAIL="admin@ownvoice.ai"
SEED_ADMIN_PASSWORD=""
SEED_SKIP_ADMIN="false"
