# Copy to android/keystore.properties (git-ignored) and fill in real values,
# or export the equivalent OWNVOICE_* environment variables in CI:
#
#   OWNVOICE_KEYSTORE_FILE=/path/to/release.keystore
#   OWNVOICE_KEYSTORE_PASSWORD=...
#   OWNVOICE_KEY_ALIAS=ownvoice
#   OWNVOICE_KEY_PASSWORD=...
#
# Never commit this file or the keystore itself.

storeFile=release.keystore
storePassword=
keyAlias=ownvoice
keyPassword=
